{
  "name": "jumpstart-usa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "JUMPSTART USA Operations Management Platform \u2014 one centralized application for a nationwide nonprofit prison re-entry ministry",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:apps": "pnpm --parallel --filter @jumpstart/api --filter @jumpstart/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @jumpstart/database generate",
    "db:migrate": "pnpm --filter @jumpstart/database migrate:dev",
    "db:deploy": "pnpm --filter @jumpstart/database migrate:deploy",
    "db:seed": "pnpm --filter @jumpstart/database seed",
    "db:test-db": "pnpm --filter @jumpstart/database test:db",
    "db:reset": "pnpm --filter @jumpstart/database migrate:reset",
    "audit": "pnpm audit --prod --audit-level=high"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "js-yaml@5": "^5.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w5hq-g745-h8pq"
      ]
    }
  }
}
