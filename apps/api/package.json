{
  "name": "@jumpstart/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @jumpstart/shared build && pnpm --filter @jumpstart/database build",
    "build": "nest build",
    "predev": "pnpm --filter @jumpstart/shared build && pnpm --filter @jumpstart/database build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jumpstart/database": "workspace:*",
    "@jumpstart/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "csv-stringify": "^6.5.2",
    "exceljs": "^4.4.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/core": "^1.10.7",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
