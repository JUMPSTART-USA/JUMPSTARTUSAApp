# ── Database ────────────────────────────────────────────────────────────────
# Postgres 16. With docker-compose this matches the db service below.
DATABASE_URL="postgresql://jumpstart:jumpstart_dev_password@localhost:5432/jumpstart?schema=public"

# Database used by the test suite (pnpm --filter api test). Same server and
# credentials as DATABASE_URL, DIFFERENT database name. Without this the suite
# shares the dev database, so signing in through the browser or clicking around
# while tests run can change the counts they assert on.
# First-time setup: pnpm db:test-db
TEST_DATABASE_URL="postgresql://jumpstart:jumpstart_dev_password@localhost:5432/jumpstart_test?schema=public"

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3001
# Secret for signing session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-generate-a-64-char-random-hex-string"
# Origin of the web SPA, for CORS + cookies
WEB_ORIGIN="http://localhost:5173"
# production | staging | development
NODE_ENV=development

# ── Web (Vite) ──────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3001"

# ── File storage (Cloudflare R2 / any S3-compatible) — Phase 2 uploads ──────
S3_ENDPOINT=""
S3_BUCKET="jumpstart-attachments"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# ── Email (Postmark) ────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=""
EMAIL_FROM="no-reply@jumpstartusa.org"

# ── SMS (Twilio) — Phase 2; 10DLC registration required ─────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Public form bot protection (Cloudflare Turnstile) ───────────────────────
TURNSTILE_SECRET_KEY=""
# Set to "true" in local dev to skip Turnstile verification on /public/* forms
TURNSTILE_DEV_BYPASS="true"

# ── Error monitoring ────────────────────────────────────────────────────────
SENTRY_DSN=""
