{
  "name": "@jumpstart/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "validate": "prisma validate",
    "seed": "tsx prisma/seed.ts",
    "seed:cm-samples": "tsx prisma/seed-cm-samples.ts",
    "seed:justice-samples": "tsx prisma/seed-justice-samples.ts",
    "seed:production": "tsx prisma/seed-production.ts",
    "seed:institutions": "tsx prisma/seed-institutions.ts",
    "db:local": "tsx scripts/dev-db.ts",
    "typecheck": "tsc --noEmit",
    "test:db": "tsx scripts/test-db.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@jumpstart/shared": "workspace:*",
    "@types/node": "^22.10.5",
    "argon2": "^0.41.1",
    "embedded-postgres": "17.5.0-beta.15",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
