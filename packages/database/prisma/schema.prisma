// JUMPSTART USA Operations Platform — database schema
//
// Design principles (see docs/database.md and the architecture plan):
//   * One person, many roles: `persons` is the identity root; participant and
//     volunteer profiles attach 1:1. Alumni-to-mentor is a status change, not a
//     new record.
//   * History is never overwritten: housing, employment, enrollments and status
//     changes append; soft deletes everywhere operationally meaningful.
//   * Audit columns: createdById/updatedById are logical references to users.id
//     (plain uuids, no FK) to keep the relation graph tractable; domain-level
//     user references (assigned case manager, note author) are true FKs.
//   * All Phase 1–3 tables ship now so historical data accumulates from day one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

